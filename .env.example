LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional. Set to 1 to refuse any request that does not come from this
# machine (loopback only). Leave unset for normal local use.
LOCAL_ONLY=0

# Access control. If ACCESS_TOKEN is set, the app asks for it before anyone
# can read or change data. Use a long random value, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it empty only for a throwaway local sandbox.
ACCESS_TOKEN=
# Idle timeout for a signed-in session, in seconds (default 1800 = 30 min).
SESSION_TTL=1800
# Comma-separated Host headers the server will answer. Defaults to
# 127.0.0.1,localhost. Add your LAN name only if you really need it.
ALLOWED_HOSTS=127.0.0.1,localhost
